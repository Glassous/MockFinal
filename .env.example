# 根目录环境变量：仅供 docker-compose.yml 使用（复制为 .env 后按需修改）
# 后端应用的全部变量在 backend/.env（见 backend/.env.example）

# PostgreSQL 密码（compose 中 db 服务与 api 服务的 DATABASE_URL 需保持一致）
POSTGRES_PASSWORD=mockfinal

# api 服务连接数据库的 DSN（容器内主机名为 db，端口 5432）
DATABASE_URL=postgresql+psycopg://mockfinal:mockfinal@db:5432/mockfinal
