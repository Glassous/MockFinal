# ===== MockFinal 后端环境变量 =====
# 复制本文件为 backend/.env 并按需填写；所有项留空时系统以「本地存储 + 无 AI」模式降级运行

# 数据库 DSN（docker compose 环境下保持默认即可；compose 的 environment 也提供了同名默认值）
DATABASE_URL=postgresql+psycopg://mockfinal:mockfinal@db:5432/mockfinal

# JWT 签名密钥（务必改为随机长字符串，泄露等于任何人可伪造登录态）
JWT_SECRET=change-me-to-a-long-random-string

# ===== LLM（生成复习大纲 / 模拟卷）=====
# OpenAI 兼容网关地址，例如 https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen-plus
# 页面助手单次回答 token 上限（成本控制）
PAGE_CHAT_MAX_TOKENS=900

# ===== PageRef Deck 规划（P3；大纲与页面计划）=====
# 页面总数下限/上限（实际页数还受密度与知识点数约束）
DECK_MIN_PAGES=6
DECK_MAX_PAGES=16
# 送入大纲规划 prompt 的资料总字符预算（超出按资料顺序截断）
DECK_MAX_MATERIAL_CHARS=200000
# 单页 bundle 字节上限（P4 保存/交付时校验）
DECK_MAX_BUNDLE_BYTES=2097152

# ===== P9 教学契约（默认关闭；黄金集门禁通过后设为 true）=====
# 开启后 Page Brief 携带 teaching_contract，新页面要求 manifest.teaching 与 schema 1.1
DECK_TEACHING_ENABLED=false
# 教学评分门禁阈值（P11 校准后作为 Builder 重试条件）
DECK_TEACHING_MIN_SCORE=70
# 单层可见正文建议值（warning 口径）
DECK_VISIBLE_LAYER_CHARS=450
# 单页总正文硬上限，超出必须拆页
DECK_TOTAL_PAGE_CHARS=700
# 页内总块数上限（含隐藏层）
DECK_MAX_PAGE_BLOCKS=8

# ===== PageRef 页面构建（P4 新增；Builder/Validator 为内部服务，不暴露公网）=====
# Pi Builder 内部地址与共享密钥（缺失时 build/rebuild 返回 503，不会伪造成功）
PAGE_BUILDER_URL=
PAGE_BUILDER_TOKEN=
# 单次 Builder 请求超时（秒）；单页构建另有「Builder + Validator 超时」硬上限
PAGE_BUILDER_TIMEOUT_SECONDS=480
# 页面并发构建数（MVP 默认 2）
PAGE_BUILDER_CONCURRENCY=2
# Deck lane 会话复用（P11；需 Builder 同时设置 BUILDER_SESSION_MODE=deck）
DECK_SESSION_REUSE_ENABLED=false
# lane 数上限（按章节成组分配，且不超过 Builder 并发）
DECK_LANE_COUNT=2
# Page Validator 内部地址与 Bearer token（缺失时 fail-closed，页面不 ready）
PAGE_VALIDATOR_URL=
PAGE_VALIDATOR_TOKEN=
# 单次最终校验超时（秒）
PAGE_VALIDATOR_TIMEOUT_SECONDS=120
# 单页最多尝试次数（含首次；最终校验失败会带问题摘要重试）
DECK_PAGE_MAX_ATTEMPTS=2
# 整个构建任务总超时（秒）；超时后取消 Builder 并把未完成页面落失败
DECK_JOB_TIMEOUT_SECONDS=1800

# ===== 阿里云 OSS（对象存储，未配置则回退到本地 backend/data）=====
# region 不带 oss- 前缀，例如 cn-hangzhou；SDK 会自动派生 endpoint
OSS_REGION=
# 可选：显式指定 endpoint（如自定义域名/内网），留空则由 region 派生
OSS_ENDPOINT=
OSS_BUCKET=
# RAM 用户的长期 AK（仅用于后端签名与调用 STS，绝不会下发给前端）
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# ===== STS（前端直传临时凭证）=====
# 留空时默认使用 OSS_REGION
STS_REGION=
# RAM 角色 ARN，形如 acs:ram::123456789012:role/mockfinal-upload
STS_ROLE_ARN=
STS_DURATION_SECONDS=3600
