{
  "name": "mockfinal-page-validator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MockFinal PageRef 页面校验服务（静态检查 + Playwright 浏览器校验）",
  "engines": {
    "node": ">=24"
