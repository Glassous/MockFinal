{
  "name": "mockfinal-page-builder",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "MockFinal PageRef 页面构建服务（Pi SDK 容器，内部 HTTP + HMAC）",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "katex": "^0.19.1",
    "typebox": "^1.3.27"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"tests/*.test.mjs\"",
    "gate:run": "node scripts/run-golden.mjs"
  }
}
