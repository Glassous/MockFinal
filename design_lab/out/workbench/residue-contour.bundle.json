      "worked_example": {
        "problem": "计算下列积分，$C$ 取正向：",
        "steps": [
          {
            "id": "s1",
            "title": "找奇点",
            "body": "分母为零给出三个一阶极点：$z=1$、$z=-2$、$z=4$。\n\n$$z_1=1,\\quad z_2=-2,\\quad z_3=4$$"
          },
          {
            "id": "s2",
            "title": "判断圈内",
            "body": "$|1|=1$、$|-2|=2$ 都在 $|z|=3$ 内；$|4|=4$ 在圈外，不贡献。"
          },
          {
            "id": "s3",
            "title": "求圈内留数",
            "body": "一阶极点用 $\\lim_{z\\to z_k}(z-z_k)f(z)$：\n\n$$\\operatorname{Res}(f,1)=\\frac{1^2+1}{(1+2)(1-4)}=-\\frac{2}{9},\\quad \\operatorname{Res}(f,-2)=\\frac{4+1}{(-2-1)(-2-4)}=\\frac{5}{18}$$"
          },
          {
            "id": "s4",
            "title": "求和乘 2πi",
            "body": "圈内留数和为 $-2/9+5/18=1/18$，所以\n\n$$I=2\\pi i\\left(-\\frac{2}{9}+\\frac{5}{18}\\right)=\\frac{\\pi i}{9}$$"
          }
        ],
        "answer": "$I=\\pi i/9$",
        "common_error": "$z=4$ 在圈外，不能算；负向曲线要乘 $-1$；奇点恰在曲线上时定理不适用。"
      },
