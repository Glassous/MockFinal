      "worked_example": {
        "problem": "用拉普拉斯变换解初值问题：",
        "steps": [
          {
            "id": "s1",
            "title": "变换",
            "body": "设 $Y=\\mathcal{L}\\{y\\}$。对方程两边取拉普拉斯变换，初值项为 $0$，右边 $\\mathcal{L}\\{e^{4t}\\}=1/(s-4)$：\n\n$$(s^2-1)Y=\\frac{1}{s-4}$$"
          },
          {
            "id": "s2",
            "title": "解出 Y(s)",
            "body": "把 $s^2-1$ 移过去，得到有理函数：\n\n$$Y(s)=\\frac{1}{(s-4)(s-1)(s+1)}$$"
          },
          {
            "id": "s3",
            "title": "部分分式",
            "body": "设 $A/(s-4)+B/(s-1)+C/(s+1)$，用留数法求系数：\n\n$$A=\\frac{1}{15},\\quad B=-\\frac{1}{6},\\quad C=\\frac{1}{10}$$"
          },
          {
            "id": "s4",
            "title": "反变换",
            "body": "逐项查表：$1/(s-a)\\leftrightarrow e^{at}$。\n\n$$y(t)=\\frac{1}{15}e^{4t}-\\frac{1}{6}e^{t}+\\frac{1}{10}e^{-t}$$"
          }
        ],
        "answer": "$y(t)=e^{4t}/15-e^{t}/6+e^{-t}/10$",
        "common_error": "$\\mathcal{L}\\{y''\\}$ 的初值项是 $s\\,y(0)+y'(0)$，不是只有 $y(0)$；部分分式系数用留数法最快，但要先确认分母已完全因式分解。"
      },
      "summary": {
        "key_points": [
          "$\\mathcal{L}\\{y'\\}=sY-y(0)$，$\\mathcal{L}\\{y''\\}=s^2Y-s\\,y(0)-y'(0)$",
          "四步：变换 → 解 $Y$ → 部分分式 → 反变换",
          "反变换后代回初值检查"
        ],
        "misconceptions": [
          "漏掉 $y'(0)$",
          "部分分式分母没完全分解"
        ],
        "next": "最后一页：全册公式与易错速查"
      }
    },
