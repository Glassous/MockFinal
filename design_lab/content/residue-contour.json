  "blocks": [
    {
      "type": "prose",
      "title": "为什么用留数",
      "text": "留数定理把复杂的围道积分降成有限个代数留数。关键不是算积分，而是判断哪些奇点被曲线圈住：圈内的留数求和，圈外的奇点直接划掉。"
    },
    {
      "type": "callout",
      "kind": "key",
      "title": "留数定理",
      "text": "设 $f$ 在简单闭曲线 $C$ 内除有限个孤立奇点外解析，且这些奇点都在 $C$ 内，则 $\\oint_C f(z)\\,dz=2\\pi i\\sum_k\\operatorname{Res}(f,z_k)$，$C$ 取正向。圈外的奇点不贡献。"
    },
    {
      "type": "formula",
      "title": "定理写法",
      "tex": "\\oint_C f(z)\\,dz=2\\pi i\\sum_{k=1}^{n}\\operatorname{Res}(f,z_k)",
      "label": "C 取正向"
    },
    {
      "type": "example",
      "label": "例题 · PDF 例 25",
      "problem": "计算下列积分，$C$ 取正向：",
      "steps": [
        {
          "title": "找奇点",
          "text": "分母为零给出三个一阶极点：$z=1$、$z=-2$、$z=4$。",
          "tex": "z_1=1,\\quad z_2=-2,\\quad z_3=4"
        },
        {
          "title": "判断圈内",
          "text": "$|1|=1$、$|-2|=2$ 都在 $|z|=3$ 内；$|4|=4$ 在圈外，不贡献。"
        },
        {
          "title": "求圈内留数",
          "text": "一阶极点用 $\\lim_{z\\to z_k}(z-z_k)f(z)$：",
          "tex": "\\operatorname{Res}(f,1)=\\frac{1^2+1}{(1+2)(1-4)}=-\\frac{2}{9},\\quad \\operatorname{Res}(f,-2)=\\frac{4+1}{(-2-1)(-2-4)}=\\frac{5}{18}"
        },
        {
          "title": "求和乘 2πi",
          "text": "圈内留数和为 $-2/9+5/18=1/18$，所以",
          "tex": "I=2\\pi i\\left(-\\frac{2}{9}+\\frac{5}{18}\\right)=\\frac{\\pi i}{9}"
        }
      ],
      "answer": "$I=\\pi i/9$",
      "pitfall": "$z=4$ 在圈外，不能算；负向曲线要乘 $-1$；奇点恰在曲线上时定理不适用。",
      "problemTex": "I=\\oint_{|z|=3}\\frac{z^2+1}{(z-1)(z+2)(z-4)}\\,dz"
    },
    {
      "type": "callout",
      "kind": "pitfall",
      "title": "留数计算的三个检查",
      "text": "① 曲线方向：负向要加负号；② 奇点是否在曲线上：在曲线上定理不适用；③ 极点的阶数：二阶及以上用导数公式，别套一阶公式。"
    }
  ],
